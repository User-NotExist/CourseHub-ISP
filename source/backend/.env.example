# Backend environment variables.
# Copy to `.env` in this directory and fill in real values:
#   cp source/backend/.env.example source/backend/.env

# PostgreSQL connection string (SQLAlchemy URL), e.g. a Supabase pooler URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must point at the frontend's relay route (coursehub/src/app/auth/callback),
# and must be registered as an authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Public URL of the frontend (used for CORS and post-login redirects).
FRONTEND_URL=http://localhost:3000

# Secret used to sign JWTs and session cookies.
# Must match JWT_SECRET_KEY in source/coursehub/.env.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me

# Set to true when served over HTTPS so auth cookies are marked Secure.
COOKIE_SECURE=false

# Resend API key for appointment emails (required: the backend fails to start without it).
RESEND_API_KEY=re_your_resend_api_key

# "From" address for appointment emails (must be a Resend-verified sender).
# Falls back to fallback-sender@test.com if unset.
SENDER_SECRET=noreply@your-domain.com
