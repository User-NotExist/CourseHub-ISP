# Frontend (Next.js) environment variables.
# Copy to `.env` in this directory and fill in real values:
#   cp source/coursehub/.env.example source/coursehub/.env

# Backend URL reached from the Next.js server.
# Use http://backend:8000 under docker compose, http://localhost:8000 when running locally.
BACKEND_URL=http://backend:8000

# Must match JWT_SECRET_KEY in source/backend/.env (used to verify the access_token cookie).
JWT_SECRET_KEY=change-me
